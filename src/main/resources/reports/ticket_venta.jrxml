	<queryString language="SQL">
		<![CDATA[SELECT 
    v.*, -- Trae automáticamente id_venta, fecha, hora, total, subtotal, igv, etc.
    p.dni AS paciente_dni,
    CONCAT(p.nombres, ' ', p.apellido_paterno) AS paciente_nombre,
    u_med.alias AS medico_nombre,
    u_caj.alias AS cajero_nombre
FROM tarifario_venta v
LEFT JOIN paciente p ON v.id_paciente = p.id_paciente
LEFT JOIN usuario u_med ON v.id_medico = u_med.codigo_usuario
LEFT JOIN usuario u_caj ON v.registrado_por = u_caj.codigo_usuario
WHERE v.id_venta = $P{idVenta}]]>
	</queryString>
